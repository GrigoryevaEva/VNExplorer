{
    "name": "visual-novels",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "changeset": "node scripts/changesets.mjs",
        "changeset:check": "node scripts/check-changeset.mjs",
        "version:release": "node scripts/changesets.mjs version && npm install --package-lock-only",
        "release:tag": "node scripts/tag-release.mjs",
        "test:e2e": "playwright test",
        "test:live": "node scripts/smoke-vndb.mjs",
        "test:static": "npm run build && node scripts/smoke-static.mjs",
        "test:handoff-live": "node scripts/smoke-handoff-live.mjs",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "lint:styles": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
        "lint:styles:fix": "stylelint \"src/**/*.{css,vue}\" --fix --max-warnings=0",
        "format:check": "prettier . --check",
        "format": "prettier . --write",
        "typecheck": "vue-tsc -b && vue-tsc --noEmit -p tsconfig.tests.json",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest"
    },
    "dependencies": {
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.10",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.13"
    }
}
