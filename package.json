{
  "name": "visual-novels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "changeset": "node scripts/changesets.mjs",
    "changeset:check": "node scripts/check-changeset.mjs",
    "version:release": "node scripts/changesets.mjs version && npm install --package-lock-only",
    "release:tag": "node scripts/tag-release.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke-vndb.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
