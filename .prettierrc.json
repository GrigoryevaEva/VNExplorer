{
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "es5",
    "arrowParens": "always",
    "bracketSpacing": true,
    "singleAttributePerLine": true,
    "vueIndentScriptAndStyle": true,
    "htmlWhitespaceSensitivity": "strict",
    "overrides": [
        { "files": "src/app/App.vue", "options": { "htmlWhitespaceSensitivity": "ignore" } }
    ],
    "endOfLine": "lf",
    "objectWrap": "preserve",
    "plugins": ["./tooling/prettier-destructuring.ts"]
}
